{
  "apiVersion": 3,
  "name": "mwm/banner",
  "title": "MWM Banner Home",
  "category": "home",
  "icon": "format-image",
  "description": "Bloque banner de valor de PlaySalud.",
  "textdomain": "mwm-blocks",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "editorScript": "file:./editor.js",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Plataforma sanitaria audiovisual"
    },
    "titleLines": {
      "type": "array",
      "default": [
        {
          "text": "Educacion sanitaria",
          "className": "t-thin"
        },
        {
          "text": "basada en evidencia,",
          "className": "t-bold accent"
        },
        {
          "text": "para pacientes, profesionales e instituciones.",
          "className": "t-thin"
        }
      ]
    },
    "titleLineCount": {
      "type": "number",
      "default": 3
    },
    "title": {
      "type": "string",
      "default": "Educacion sanitaria basada en evidencia, para pacientes, profesionales e instituciones."
    },
    "lead": {
      "type": "string",
      "default": "Videos breves, claros y revisados por profesionales. Listos para integrarse en hospitales, aseguradoras, universidades, sociedades cientificas y asociaciones de pacientes."
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": "PlaySalud"
    },
    "caption": {
      "type": "string",
      "default": ""
    }
  },
  "supports": { "anchor": true }
}
