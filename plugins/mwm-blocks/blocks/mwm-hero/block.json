    "primaryUrl": {
      "type": "string",
      "default": "#contacto"
    },
    "secondaryText": {
      "type": "string",
      "default": "Explorar PlayCare y PlayAcademy"
    },
    "secondaryUrl": {
      "type": "string",
      "default": "#verticales"
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": "PlaySalud"
    }
  },
  "supports": {
    "anchor": true,
    "align": ["wide", "full"]
  }
