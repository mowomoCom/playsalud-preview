{
  "apiVersion": 3,
  "name": "mwm/hero",
  "title": "MWM Hero Home",
  "category": "home",
  "icon": "cover-image",
  "description": "Bloque Hero principal de PlaySalud.",
  "textdomain": "mwm-blocks",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "editorScript": "file:./editor.js",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Plataforma de salud audiovisual"
    },
    "titleLines": {
      "type": "array",
      "default": [
        {
          "text": "Salud en video.",
          "className": "t-bold"
        },
        {
          "text": "Seria cuando toca,",
          "className": "t-thin accent"
        },
        {
          "text": "cercana cuando ayuda.",
          "className": "t-thin"
        }
      ]
    },
    "titleLineCount": {
      "type": "number",
      "default": 3
    },
    "title": {
      "type": "string",
      "default": "Salud en video. Seria cuando toca, cercana cuando ayuda."
    },
    "lead": {
      "type": "string",
      "default": "PlaySalud transforma informacion clinica compleja en videos breves, claros y basados en evidencia para pacientes y profesionales."
    },
    "primaryText": {
      "type": "string",
      "default": "Solicitar demo institucional"
    },
    "primaryUrl": {
      "type": "string",
      "default": "#contacto"
    },
    "secondaryText": {
      "type": "string",
      "default": "Explorar PlayCare y PlayAcademy"
    },
    "secondaryUrl": {
      "type": "string",
      "default": "#verticales"
    },
    "trustText": {
      "type": "string",
      "default": "Hospitales, sociedades cientificas y universidades nos avalan"
    },
    "trustDotsCount": {
      "type": "number",
      "default": 3
    },
    "showTrust": {
      "type": "boolean",
      "default": true
    },
    "showFloatCare": {
      "type": "boolean",
      "default": true
    },
    "floatCareLabel": {
      "type": "string",
      "default": "PlayCare"
    },
    "floatCareValue": {
      "type": "string",
      "default": "300+"
    },
    "floatCareSub": {
      "type": "string",
      "default": "videos clinicos"
    },
    "showFloatAcademy": {
      "type": "boolean",
      "default": true
    },
    "floatAcademyLabel": {
      "type": "string",
      "default": "PlayAcademy"
    },
    "floatAcademyValue": {
      "type": "string",
      "default": "Curso I"
    },
    "floatAcademySub": {
      "type": "string",
      "default": "IA en Salud - 8 sem."
    },
    "showPhotoMeta": {
      "type": "boolean",
      "default": true
    },
    "photoMetaTag": {
      "type": "string",
      "default": "Cirugia"
    },
    "photoMetaTime": {
      "type": "string",
      "default": "3:42"
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": "PlaySalud"
    }
  },
  "supports": {
    "anchor": true,
    "align": ["wide", "full"]
  }
}
