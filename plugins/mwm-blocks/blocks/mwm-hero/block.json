{
  "apiVersion": 3,
  "name": "mwm/hero",
  "title": "MWM Hero Home",
  "category": "home",
  "icon": "cover-image",
  "description": "Bloque Hero principal de PlaySalud.",
  "textdomain": "mwm-blocks",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "editorScript": "file:./editor.js",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Plataforma de salud audiovisual"
