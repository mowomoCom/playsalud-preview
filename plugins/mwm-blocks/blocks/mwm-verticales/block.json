{
  "apiVersion": 3,
  "name": "mwm/verticales",
  "title": "MWM Verticales Home",
  "category": "home",
  "icon": "columns",
  "description": "Bloque de verticales PlayCare y PlayAcademy.",
  "textdomain": "mwm-blocks",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "editorScript": "file:./editor.js",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Dos brazos, un lenguaje"
    },
    "title": {
      "type": "string",
      "default": "PlayCare y PlayAcademy."
    },
    "careTitle": {
      "type": "string",
      "default": "PlayCare"
    },
    "careText": {
      "type": "string",
      "default": "Videos de cuidados de salud por modulos para instituciones y equipos clinicos."
    },
    "careButtonText": {
      "type": "string",
      "default": "Ver modulos"
    },
    "careButtonUrl": {
      "type": "string",
      "default": "#modulos"
