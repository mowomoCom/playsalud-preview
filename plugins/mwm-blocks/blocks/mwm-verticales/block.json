    "academyTitle": {
      "type": "string",
      "default": "PlayAcademy"
    },
    "academyText": {
      "type": "string",
      "default": "Cursos acreditados para sanitarios con itinerario progresivo en IA aplicada."
    },
    "academyButtonText": {
      "type": "string",
      "default": "Ver curso"
    },
    "academyButtonUrl": {
      "type": "string",
      "default": "#curso"
    }
  },
  "supports": { "anchor": true }
}
